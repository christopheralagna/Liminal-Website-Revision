// Approved Phase 4 foundation. Auth core reconciled with Better Auth 1.7.18.
// Target: Prisma 7 + PostgreSQL; DATABASE_URL configured in Prisma config in Stage B.
// See docs/generated/better-auth-1.7.18.prisma and Stage B reconciliation notes.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  ADMIN
  COORDINATOR
  VIEWER
}

enum VolunteerStatus {
  ACTIVE
  INACTIVE
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  COMPLETED
  CANCELLED
}

// Auth library owns password hashing, credentials, tokens, and session lifecycle.
// Configure Better Auth UUID generation; role/isActive are server-owned additional fields.
model User {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  role             AppRole           @default(VIEWER)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  accounts         Account[]
  sessions         Session[]
  volunteerProfile VolunteerProfile?
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  password              String? // Library-managed hash, never plaintext.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
}

// A volunteer does not need a login. Administrative records are synthetic only.
model VolunteerProfile {
  id                   String                    @id @default(uuid()) @db.Uuid
  userId               String?                   @unique @db.Uuid
  displayName          String
  email                String? // Synthetic @example.invalid only in seeds.
  status               VolunteerStatus           @default(ACTIVE)
  // Current recorded certificate only; neither date confers role membership.
  // Dates are optional independently; missing information is not proof of validity.
  foodHandlerIssuedOn  DateTime?                 @db.Date
  foodHandlerExpiresOn DateTime?                 @db.Date
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)
  user                 User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  roles                VolunteerRoleMembership[]
  availability         Availability[]
  assignments          ShiftAssignment[]

  @@index([status])
}

// Operational roles are configurable and confer NO application access permissions.
model VolunteerRole {
  id          String                    @id @default(uuid()) @db.Uuid
  name        String                    @unique
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(3)
  volunteers  VolunteerRoleMembership[]
  definitions ShiftDefinition[]
}

model VolunteerRoleMembership {
  volunteerId String           @db.Uuid
  roleId      String           @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  volunteer   VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Restrict)
  role        VolunteerRole    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([volunteerId, roleId])
  @@index([roleId])
}

// Local weekly windows; 0=Sunday. Minutes since midnight, end exclusive.
// Overnight availability is represented by two windows on adjacent weekdays.
model Availability {
  id          String           @id @default(uuid()) @db.Uuid
  volunteerId String           @db.Uuid
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  timeZone    String           @default("America/Phoenix")
  validFrom   DateTime         @db.Date
  validUntil  DateTime?        @db.Date
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  volunteer   VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Restrict)

  @@index([volunteerId, dayOfWeek, validFrom])
}

// Reusable definitions are not a recurring schedule by themselves.
model ShiftDefinition {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  roleId    String         @db.Uuid
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  role      VolunteerRole  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  patterns  ShiftPattern[]
  shifts    Shift[]

  @@index([roleId])
}

// Weekly recurrence only; one row per weekday, bounded by local calendar dates.
model ShiftPattern {
  id              String          @id @default(uuid()) @db.Uuid
  definitionId    String          @db.Uuid
  dayOfWeek       Int
  startMinute     Int
  durationMinutes Int
  capacity        Int
  timeZone        String          @default("America/Phoenix")
  validFrom       DateTime        @db.Date
  validUntil      DateTime?       @db.Date
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  definition      ShiftDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  shifts          Shift[]

  @@index([definitionId, isActive])
}

// Actual occurrences have absolute timestamps and their own capacity.
// Event links may be introduced in a later migration when that domain is implemented.
model Shift {
  id           String            @id @default(uuid()) @db.Uuid
  definitionId String            @db.Uuid
  patternId    String?           @db.Uuid
  // Immutable original local date for recurring shifts; null for one-time shifts.
  occurrenceDate DateTime?        @db.Date
  startsAt     DateTime          @db.Timestamptz(3)
  endsAt       DateTime          @db.Timestamptz(3)
  capacity     Int
  status       ShiftStatus       @default(SCHEDULED)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  definition   ShiftDefinition   @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  pattern      ShiftPattern?     @relation(fields: [patternId], references: [id], onDelete: Restrict)
  assignments  ShiftAssignment[]

  @@unique([patternId, startsAt])
  @@unique([patternId, occurrenceDate])
  @@index([startsAt, endsAt])
  @@index([definitionId])
}

// Coordinators cancel/reassign through these rows; no coverage-request workflow.
// Preserve the original volunteerId when cancelling an assignment.
model ShiftAssignment {
  id          String           @id @default(uuid()) @db.Uuid
  shiftId     String           @db.Uuid
  volunteerId String           @db.Uuid
  status      AssignmentStatus @default(ASSIGNED)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  shift       Shift            @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  volunteer   VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Restrict)

  @@unique([shiftId, volunteerId])
  @@index([volunteerId, status])
}
