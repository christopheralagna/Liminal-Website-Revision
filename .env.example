# Copy to .env and replace BOTH placeholder passwords. Never commit .env.
# Local services bind only to 127.0.0.1. URL passwords must be URL-encoded.
POSTGRES_DEV_PASSWORD=replace-with-a-random-password
POSTGRES_TEST_PASSWORD=replace-with-a-different-random-password
DATABASE_URL=postgresql://liminal_dev:replace-with-a-random-password@127.0.0.1:5434/liminal_dev
TEST_DATABASE_URL=postgresql://liminal_test:replace-with-a-different-random-password@127.0.0.1:5435/liminal_test
# Auth is lazy: public pages/builds do not require these variables.
BETTER_AUTH_URL=http://localhost:3000
# Generate independently: node -e 'process.stdout.write(require("node:crypto").randomBytes(48).toString("base64url")+"\n")'
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
